# Service Configuration
# Path to local VibeVoice model or specific model ID
TTS_MODEL_PATH=microsoft/VibeVoice-Realtime-0.5B
# Whisper model size (tiny, base, small, medium, large)
WHISPER_MODEL_SIZE=medium

# RAG Configuration
# Path to persist vector database (ChromaDB)
CHROMA_DB_PATH=./chroma_db
# Collection names
RAG_COLLECTION_TECHNICAL=technical_collection
RAG_COLLECTION_AGRICULTURE=agriculture_collection
# Knowledge base directories (relative to CWD, i.e. backend/)
KNOWLEDGE_BASE_TECHNICAL=./knowledge/technical
KNOWLEDGE_BASE_AGRICULTURE=./knowledge/agriculture

# Server Configuration
HOST=0.0.0.0
PORT=8000


# --- AI PROVIDER SWITCH ---
# Options: GEMINI or OLLAMA or AZURE
LLM_PROVIDER=AZURE

# --- GOOGLE CONFIG ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- LOCAL CONFIG ---
OLLAMA_MODEL=llama3:8b-instruct-q4_K_M
OLLAMA_URL=http://localhost:11434

# --- AZURE CONFIG ---
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_NAME=gpt-4.1-mini
